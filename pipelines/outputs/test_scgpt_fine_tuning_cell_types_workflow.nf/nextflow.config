docker {
   enabled = true
   runOptions = '--gpus=all'
}

params {
   container_image = 'scgpt-scgpt:latest'
}

plugins = ['nf-prov']
poolSize = 22

prov {
   enabled = true
   formats {
      wrroc {
         file = 'outputs/test_scgpt_fine_tuning_cell_types_workflow.nf/ro-crate-metadata.json'
         license = 'https://spdx.org/licenses/MIT'
         overwrite = true
      }
   }
}

runName = 'silly_hilbert'
workDir = '../.work'
